//--- shared by every model in this build
#define MINTYAI_MODEL_FEATURE_VERSION 1
#define MINTYAI_MODEL_FEATURE_COUNT   24
#define MINTYAI_MODEL_SIGNATURE       1024824758
#define MINTYAI_MODEL_WINDOW          96
#define MINTYAI_MODEL_TIMEFRAME       "H1"

//--- The training bars were stamped in the training SERVER's own local
//--- clock, not in UTC - see MintyAIExporter.mqh, which writes
//--- rates[].time unconverted. That is deliberate: the server clock
//--- moves with daylight saving and so do the sessions the model keys
//--- off, so hour-of-day stays aligned all year without conversion.
//---
//--- This is that server's UTC offset AT EXPORT TIME, a single reading,
//--- recorded so a broker in a genuinely different timezone can be
//--- corrected for. It is NOT a year-round constant: on a DST-observing
//--- server it reads an hour differently in winter, which is why the EA
//--- ignores gaps of an hour or less rather than 'correcting' a clock
//--- against itself.
#define MINTYAI_MODEL_UTC_OFFSET_H    3

//--- the trade definition the labels were built from. The EA's stop,
//--- target and time exit MUST mirror these or the probabilities
//--- describe a trade you are not actually taking.
#define MINTYAI_MODEL_BARRIER_ATR     3.0
#define MINTYAI_MODEL_HORIZON_BARS    24
#define MINTYAI_MODEL_SLIPPAGE_POINTS 2.0

#define MINTYAI_MODEL_COUNT           37
#define MINTYAI_RISK_COUNT            3

//--- One network PER SYMBOL. Pooling every instrument into a shared
//--- model was tried and measured worse: the shared function ends up
//--- a compromise that prices none of them sharply, and its
//--- probabilities collapse toward the base rate.
//---
//--- Every graph travels inside the .ex5: a strategy tester agent gets
//--- its own empty MQL5\Files sandbox, so loading by path fails there
//--- with error 5019 however plainly the file sits in the data folder.
