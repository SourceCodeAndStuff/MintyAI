//--- The models this build carries. The EA's Model input IS this enum,
//--- so the dropdown cannot offer a model that does not exist, and the
//--- value doubles as the index into MintyAIModels[].
//---
//--- AUTO is declared first so it is what the terminal shows by default.
//--- It works the model out from the chart symbol, which handles every
//--- broker that merely decorates the standard name - EURUSD.ecn, and
//--- so on. Naming a model outright is for the ones that rename the
//--- instrument altogether: a chart called GOLD carries nothing an
//--- algorithm could match to XAUUSD, so the user says which it is.
enum ENUM_MINTYAI_SYMBOL
  {
   MINTYAI_SYM_AUTO           = -1,   // Auto - match the chart symbol
   MINTYAI_SYM_ADAUSD         = 0,   // ADAUSD
   MINTYAI_SYM_AUDCAD         = 1,   // AUDCAD
   MINTYAI_SYM_AUDCHF         = 2,   // AUDCHF
