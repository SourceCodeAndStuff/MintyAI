//+------------------------------------------------------------------+
//| Create the ONNX session for a symbol's own network.               |
//+------------------------------------------------------------------+
long MintyAICreateOnnx(const int idx)
  {
   switch(idx)
     {
      case 0: return OnnxCreateFromBuffer(ExtMintyAIModel0, ONNX_DEFAULT);
      case 1: return OnnxCreateFromBuffer(ExtMintyAIModel1, ONNX_DEFAULT);
      case 2: return OnnxCreateFromBuffer(ExtMintyAIModel2, ONNX_DEFAULT);
