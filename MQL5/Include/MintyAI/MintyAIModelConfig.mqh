   MINTYAI_SYM_XRPUSD         = 36   // XRPUSD
  };

#define MINTYAI_DEFAULT_SYMBOL    MINTYAI_SYM_ADAUSD

//--- Risk presets. The weights behind each are the same; the stake and
//--- the halts that follow from it are not.
enum ENUM_MINTYAI_RISK
  {
   MINTYAI_RISK_LOW    = 0,   // Low - up to 2% of equity per trade
   MINTYAI_RISK_MEDIUM = 1,   // Medium - up to 5% of equity per trade
   MINTYAI_RISK_HIGH   = 2   // High - up to 10% of equity per trade
  };

struct MintyAIRiskCfg
  {
   double            max_risk_pct;     // cap per trade, % of equity
   double            daily_loss_pct;   // daily halt
   double            max_dd_pct;       // total drawdown halt
   double            sim_dd_pct;       // drawdown this cap produced on validation
  };

struct MintyAIModelCfg
  {
   string            symbol;
   double            min_prob;         // entry gate, chosen on validation
   double            edge_mult;        // required edge, in units of cost
   double            kelly_scale;
   uint              hour_mask;        // 24-bit mask of tradable hours
   int               wf_trades;        // walk-forward, out-of-sample
   double            wf_total_r;
   double            wf_tstat;
   MintyAIRiskCfg    risk[3];
  };

MintyAIModelCfg MintyAIModels[MINTYAI_MODEL_COUNT];

