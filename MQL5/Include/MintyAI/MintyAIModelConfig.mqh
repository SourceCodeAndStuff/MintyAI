      case 34: return OnnxCreateFromBuffer(ExtMintyAIModel34, ONNX_DEFAULT);
      case 35: return OnnxCreateFromBuffer(ExtMintyAIModel35, ONNX_DEFAULT);
      case 36: return OnnxCreateFromBuffer(ExtMintyAIModel36, ONNX_DEFAULT);
     }
   return INVALID_HANDLE;
  }

//+------------------------------------------------------------------+
//| Index of a symbol's model, or -1.                                |
//+------------------------------------------------------------------+
int MintyAIFindModel(const string symbol)
  {
   for(int i = 0; i < MINTYAI_MODEL_COUNT; i++)
      if(MintyAIModels[i].symbol == symbol)
         return i;
   return -1;
  }

//--- for error messages: every symbol this build can trade
string MintyAISymbolList()
  {
   string s = "";
   for(int i = 0; i < MINTYAI_MODEL_COUNT; i++)
      s += (i == 0 ? "" : ", ") + MintyAIModels[i].symbol;
   return s;
  }

#endif // MINTYAI_MODEL_CONFIG_MQH
